[Unit]
Description=Code Grader Service
After=isolate.service
Wants=isolate.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/grader
ExecStartPre=/usr/local/bin/isolate --cg -b 999 --cleanup
ExecStartPre=/usr/local/bin/isolate --cg -b 999 --init
ExecStart=/usr/local/bin/grader
# Backstop for a box whose keeper is gone some other way: after every exit, kill the cgroups of the pool's
# boxes (1 to GRADER_WORKER_COUNT, as in internal/pool). On a crash KillMode=mixed already SIGKILLs the
# keepers, and each keeper is init of its box's PID namespace, so the kernel kills the program with it.
ExecStopPost=-/bin/sh -c 'r=$$(cat /run/isolate/cgroup 2>/dev/null); case "$$r" in *..*) exit 0;; /sys/fs/cgroup/*) ;; *) exit 0;; esac; i=1; while [ "$$i" -le "$${GRADER_WORKER_COUNT:-3}" ]; do k="$$r/box-$$i/cgroup.kill"; [ -f "$$k" ] && echo 1 > "$$k"; i=$$((i+1)); done; exit 0'
# SIGTERM only the grader, not its isolate keepers (see grader-docker.service).
KillMode=mixed
# The stop takes about 7.5 s (5 s grace + 2.5 s release, README "Callback"). 10 s leaves room for
# Pool.Close and matches Docker's stop timeout; then SIGKILL, and the next start cleans the boxes.
TimeoutStopSec=10s
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target