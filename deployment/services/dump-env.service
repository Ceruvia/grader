[Unit]
Description=Capture Docker Environment Variables
DefaultDependencies=no
Before=grader.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c "tr '\\0' '\\n' < /proc/1/environ | grep -E '^(GRADER_|QUEUE_|BACKEND_|MONITORING_|LOAD_DOTENV=)' > /etc/docker_env"
RemainAfterExit=true

[Install]
WantedBy=multi-user.target