# Grader configuration. Local run: copy to .env. In the container, set these as real
# environment variables, only names starting with GRADER_, QUEUE_, BACKEND_, MONITORING_ or
# LOAD_DOTENV reach the grader process (everything else is dropped by dump-env.service).

# true: read this .env file. Compose and the VPS set false and pass real env vars.
LOAD_DOTENV=true

GRADER_NAME=test_grader
GRADER_ENV=development
# Boxes graded in parallel inside one grader container. Start at the number of CPU cores of the
# VM (leave one core free when the backend or broker share it) and give each worker at least
# 512 MB of RAM. More workers than cores make time limits unfair, because boxes compete for CPU.
# The code default is 20, which suits a large VM only.
GRADER_WORKER_COUNT=4

# Must equal QUEUE_NAME in the backend, or submissions are never picked up.
QUEUE_NAME=grading_queue
QUEUE_BROKER_URL=amqp://ceruvia:ceruvia@localhost:5672/
QUEUE_RESULT_URL=amqp://ceruvia:ceruvia@localhost:5672/
QUEUE_RESULT_TTL=36000

# The grader reports each verdict here. Must equal APP_API_KEY in the backend.
# In the production compose stack the endpoint goes through the ingress:
#   http://ingress/v1/submissions/{submission_id}/programming/grade-callback
BACKEND_API_TOKEN=
BACKEND_CALLBACK_ENDPOINT=http://localhost:8080/v1/submissions/{submission_id}/programming/grade-callback
