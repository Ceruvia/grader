# Grader configuration. Local run: copy to .env, fill required values, then explicitly
# set LOAD_DOTENV=true when launching. For debug logs set GRADER_ENV=development.
# Containers receive real environment variables. Only names starting with GRADER_,
# QUEUE_, BACKEND_, MONITORING_, PUBSUB_ or LOAD_DOTENV, GCP_PROJECT_ID and
# GOOGLE_APPLICATION_CREDENTIALS pass through dump-env.service.

# Default false: read real environment variables, without requiring a .env file.
# Explicit true loads .env and fails startup if that file cannot be read.
LOAD_DOTENV=false

GRADER_NAME=test_grader
GRADER_ENV=production
# Boxes graded in parallel inside one grader container. The code default is 3.
# Keep this no higher than the VM's available CPU cores (leave one core free when
# the backend or broker share it) and budget RAM for compilers, runtime and the
# 256 MiB per-box scratch limit. More workers can make time limits unfair.
GRADER_WORKER_COUNT=3

# Broker: amqp (RabbitMQ, the default) or gcppubsub (GCP Pub/Sub).
QUEUE_BROKER=amqp

# amqp only. Must equal QUEUE_NAME in the backend, or submissions are never picked up.
# QUEUE_NAME and QUEUE_BROKER_URL are required in production with amqp. Local
# addresses below are explicit development examples, not code defaults.
QUEUE_NAME=grading_queue
QUEUE_BROKER_URL=amqp://ceruvia:ceruvia@localhost:5672/

# gcppubsub only. GCP_PROJECT_ID and PUBSUB_SUBSCRIPTION_NAME are required in
# production with gcppubsub. The subscription must be on the topic the backend
# publishes to. PUBSUB_TOPIC_NAME is read only by cmd/send.
# GOOGLE_APPLICATION_CREDENTIALS is the path of a mounted service account key file.
# PUBSUB_EMULATOR_HOST points the client at a local emulator, never set it on a VM.
GCP_PROJECT_ID=
PUBSUB_SUBSCRIPTION_NAME=
PUBSUB_TOPIC_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# The grader reports each final result here, with the result in the body. Both
# names are required in production. The token must equal APP_API_KEY in the backend.
# In the production compose stack the endpoint goes through the ingress:
#   http://ingress/v1/submissions/{submission_id}/programming/grade-callback
BACKEND_API_TOKEN=
BACKEND_CALLBACK_ENDPOINT=http://localhost:8080/v1/submissions/{submission_id}/programming/grade-callback
