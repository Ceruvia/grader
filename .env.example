# Grader configuration. Local run: copy to .env, fill required values, then explicitly
# set LOAD_DOTENV=true when launching. For debug logs set GRADER_ENV=development.
# Containers receive real environment variables. Only names starting with GRADER_,
# QUEUE_, BACKEND_, MONITORING_ or LOAD_DOTENV pass through dump-env.service.

# Default false: read real environment variables, without requiring a .env file.
# Explicit true loads .env and fails startup if that file cannot be read.
LOAD_DOTENV=false

GRADER_NAME=test_grader
GRADER_ENV=production
# Boxes graded in parallel inside one grader container. The code default is 3.
# Keep this no higher than the VM's available CPU cores (leave one core free when
# the backend or broker share it) and budget RAM for compilers, runtime and the
# 256 MiB per-box scratch limit. More workers can make time limits unfair.
GRADER_WORKER_COUNT=3

# Must equal QUEUE_NAME in the backend, or submissions are never picked up.
# QUEUE_NAME, QUEUE_BROKER_URL, QUEUE_RESULT_URL, BACKEND_API_TOKEN and
# BACKEND_CALLBACK_ENDPOINT are required in production. Local addresses below are
# explicit development examples, not code defaults. Use deployment values on a VM.
QUEUE_NAME=grading_queue
QUEUE_BROKER_URL=amqp://ceruvia:ceruvia@localhost:5672/
QUEUE_RESULT_URL=amqp://ceruvia:ceruvia@localhost:5672/
QUEUE_RESULT_TTL=36000

# The grader reports each verdict here. Must equal APP_API_KEY in the backend.
# In the production compose stack the endpoint goes through the ingress:
#   http://ingress/v1/submissions/{submission_id}/programming/grade-callback
BACKEND_API_TOKEN=
BACKEND_CALLBACK_ENDPOINT=http://localhost:8080/v1/submissions/{submission_id}/programming/grade-callback
