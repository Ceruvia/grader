GRADER_NAME=test_grader
GRADER_ENV=development
GRADER_WORKER_COUNT=20
LOAD_DOTENV=true

# GCP Pub/Sub
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION_NAME=grading-tasks-sub
PUBSUB_TOPIC_NAME=grading-tasks

# Callback (Backend API)
CALLBACK_BASE_URL=http://localhost:8080
CALLBACK_API_KEY=your-api-key

# Monitoring (set to true to enable)
METRICS_ENABLED=false
LOGGING_ENABLED=false
MONITORING_LOKI_URL=
MONITORING_INFLUX_URL=
MONITORING_INFLUX_TOKEN=
MONITORING_INFLUX_ORGANIZATION=
MONITORING_INFLUX_BUCKET=
